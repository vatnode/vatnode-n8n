		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "c1000000-0000-4000-8000-000000000001",
							"leftValue": "={{ $json.validFormat }}",
							"rightValue": true,
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "a1000000-0000-4000-8000-000000000003",
			"name": "Format looks right?",
