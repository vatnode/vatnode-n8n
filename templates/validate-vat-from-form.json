		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "c1000000-0000-4000-8000-000000000002",
							"leftValue": "={{ $json.valid }}",
							"rightValue": true,
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
